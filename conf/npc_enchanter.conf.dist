###################################################################################################
#  mod-npc-enchanter (SquidBots)
#
#  An NPC (creature entry 9785001) that applies permanent enchantments to the items a player
#  wears. The list of enchantments is read from the client data (every Enchanting recipe that
#  carries an "enchant item" effect), never from a hard coded list, so CoA's own recipes are
#  offered next to the classic ones.
#
#  Each enchantment belongs to one tier:
#      60 - classic and CoA content (the default realm)
#      70 - The Burning Crusade enchantments
#      80 - Wrath of the Lich King enchantments
#  A server owner opens higher tiers with EnchanterNpc.AllowedTiers.
#
#  This code is part of the AzerothCore project. See AUTHORS file for Copyright information.
###################################################################################################

#    EnchanterNpc.Enable
#        Description: Turn the enchanter on. When off, the NPC is invisible and does nothing.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)
EnchanterNpc.Enable = 0

#    EnchanterNpc.AllowedTiers
#        Description: Comma separated list of the enchantment tiers the NPC offers.
#                     60 is always the base; add 70 and/or 80 to open the higher tiers.
#                     An empty or invalid value falls back to "60".
#        Example:     "60"        - level 60 enchantments only
#                     "60,70"     - adds The Burning Crusade enchantments
#                     "60,70,80"  - every enchantment
#        Default:     "60"
EnchanterNpc.AllowedTiers = "60"

#    EnchanterNpc.CostGold60
#    EnchanterNpc.CostGold70
#    EnchanterNpc.CostGold80
#        Description: Price in gold of one enchantment of each tier. 0 makes it free.
#                     The price is shown in the confirmation box before the player accepts.
#        Default:     1, 5, 10
EnchanterNpc.CostGold60 = 1
EnchanterNpc.CostGold70 = 5
EnchanterNpc.CostGold80 = 10

#    EnchanterNpc.RequireProfession
#        Description: Keep the profession lock of the enchantments that need one (for example
#                     ring enchantments, which only an enchanter may wear).
#        Default:     1 - (Keep the lock)
#                     0 - (Offer them to everyone)
EnchanterNpc.RequireProfession = 1

#    EnchanterNpc.RespectRequiredLevel
#        Description: Hide the enchantments whose required level is above the player's level.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
EnchanterNpc.RespectRequiredLevel = 1

#    EnchanterNpc.ExcludeSpells
#        Description: Comma separated list of enchanting spell ids never offered by the NPC.
#                     For a per-spell tier fix, use the world table mod_npc_enchanter_override.
#        Default:     ""
EnchanterNpc.ExcludeSpells = ""

#    EnchanterNpc.LogCatalog
#        Description: At startup, log how many enchantments each tier holds, and with 2 every
#                     enchantment with its tier (to check the classification).
#        Default:     1 - (Counts)
#                     0 - (Silent)
#                     2 - (Full list)
EnchanterNpc.LogCatalog = 1
